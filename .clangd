CompileFlags:
  CompilationDatabase: build
  # Keep editor warnings visible without promoting diagnostics originating in
  # dependency macros to hard parse errors.
  Remove: [-Werror]

Index:
  Background: Build

---

If:
  PathMatch: tests/.*

CompileFlags:
  # Catch2 uses __COUNTER__; LLVM 22 diagnoses its macro expansion as a C2y
  # extension when parsing the C++23 test translation unit.
  Add: [-Wno-c2y-extensions]
