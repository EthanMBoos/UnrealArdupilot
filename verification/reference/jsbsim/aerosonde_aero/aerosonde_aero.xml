<?xml version="1.0"?>
<!--
  GPL-3.0 BYU-derived offline validation fixture. Not installed or packaged with
  uvd_core. Equations mirror docs/AERO.md; parameter provenance is recorded in
  examples/aircraft/aerosonde.json.
-->
<fdm_config name="UVDAeroOnly" version="2.0" release="ALPHA">
  <fileheader>
    <author>UnrealVehicleDynamics contributors</author>
    <description>Aero-only MAVSim educational Aerosonde equation fixture</description>
  </fileheader>
  <metrics>
    <wingarea unit="M2">0.55</wingarea><wingspan unit="M">2.8956</wingspan><chord unit="M">0.18994</chord>
    <htailarea unit="M2">0</htailarea><htailarm unit="M">0</htailarm><vtailarea unit="M2">0</vtailarea><vtailarm unit="M">0</vtailarm>
    <location name="AERORP" unit="M"><x>0</x><y>0</y><z>0</z></location>
    <location name="EYEPOINT" unit="M"><x>0</x><y>0</y><z>0</z></location>
    <location name="VRP" unit="M"><x>0</x><y>0</y><z>0</z></location>
  </metrics>
  <mass_balance>
    <ixx unit="KG*M2">0.8244</ixx><iyy unit="KG*M2">1.135</iyy><izz unit="KG*M2">1.759</izz><ixz unit="KG*M2">0.1204</ixz>
    <emptywt unit="KG">11</emptywt><location name="CG" unit="M"><x>0</x><y>0</y><z>0</z></location>
  </mass_balance>
  <ground_reactions/>
  <propulsion/>
  <flight_control name="direct surface properties"/>
  <aerodynamics>
    <function name="uvd/sigma">
      <quotient>
        <sum><value>1</value><exp><product><value>-50</value><difference><property>aero/alpha-rad</property><value>0.47</value></difference></product></exp><exp><product><value>50</value><sum><property>aero/alpha-rad</property><value>0.47</value></sum></product></exp></sum>
        <product><sum><value>1</value><exp><product><value>-50</value><difference><property>aero/alpha-rad</property><value>0.47</value></difference></product></exp></sum><sum><value>1</value><exp><product><value>50</value><sum><property>aero/alpha-rad</property><value>0.47</value></sum></product></exp></sum></product>
      </quotient>
    </function>
    <function name="uvd/cl-linear"><sum><value>0.23</value><product><value>5.61</value><property>aero/alpha-rad</property></product></sum></function>
    <function name="uvd/cl-base">
      <sum>
        <product><difference><value>1</value><property>uvd/sigma</property></difference><property>uvd/cl-linear</property></product>
        <product><property>uvd/sigma</property><value>2</value><sin><property>aero/alpha-rad</property></sin><abs><sin><property>aero/alpha-rad</property></sin></abs><cos><property>aero/alpha-rad</property></cos></product>
      </sum>
    </function>
    <function name="uvd/CL"><sum><property>uvd/cl-base</property><product><value>7.95</value><property>aero/ci2vel</property><property>velocities/q-aero-rad_sec</property></product><product><value>0.13</value><property>uvd/elevator-rad</property></product></sum></function>
    <function name="uvd/CD"><sum><value>0.043</value><quotient><product><property>uvd/cl-linear</property><property>uvd/cl-linear</property></product><value>43.102933516479794</value></quotient><product><value>0.0135</value><property>uvd/elevator-rad</property></product></sum></function>
    <function name="uvd/CY"><sum><product><value>-0.98</value><property>aero/beta-rad</property></product><product><value>0.075</value><property>uvd/aileron-rad</property></product><product><value>0.19</value><property>uvd/rudder-rad</property></product></sum></function>
    <function name="uvd/Cl"><sum><product><value>-0.13</value><property>aero/beta-rad</property></product><product><value>-0.51</value><property>aero/bi2vel</property><property>velocities/p-aero-rad_sec</property></product><product><value>0.25</value><property>aero/bi2vel</property><property>velocities/r-aero-rad_sec</property></product><product><value>0.17</value><property>uvd/aileron-rad</property></product><product><value>0.0024</value><property>uvd/rudder-rad</property></product></sum></function>
    <function name="uvd/Cm"><sum><value>0.0135</value><product><value>-2.74</value><property>aero/alpha-rad</property></product><product><value>-38.21</value><property>aero/ci2vel</property><property>velocities/q-aero-rad_sec</property></product><product><value>-0.99</value><property>uvd/elevator-rad</property></product></sum></function>
    <function name="uvd/Cn"><sum><product><value>0.073</value><property>aero/beta-rad</property></product><product><value>0.069</value><property>aero/bi2vel</property><property>velocities/p-aero-rad_sec</property></product><product><value>-0.095</value><property>aero/bi2vel</property><property>velocities/r-aero-rad_sec</property></product><product><value>-0.011</value><property>uvd/aileron-rad</property></product><product><value>-0.069</value><property>uvd/rudder-rad</property></product></sum></function>
    <axis name="X"><function name="aero/force/uvd-x"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><sum><product><value>-1</value><property>uvd/CD</property><cos><property>aero/alpha-rad</property></cos></product><product><property>uvd/CL</property><sin><property>aero/alpha-rad</property></sin></product></sum></product></function></axis>
    <axis name="Y"><function name="aero/force/uvd-y"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>uvd/CY</property></product></function></axis>
    <axis name="Z"><function name="aero/force/uvd-z"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><sum><product><value>-1</value><property>uvd/CD</property><sin><property>aero/alpha-rad</property></sin></product><product><value>-1</value><property>uvd/CL</property><cos><property>aero/alpha-rad</property></cos></product></sum></product></function></axis>
    <axis name="ROLL"><function name="aero/moment/uvd-roll"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/bw-ft</property><property>uvd/Cl</property></product></function></axis>
    <axis name="PITCH"><function name="aero/moment/uvd-pitch"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/cbarw-ft</property><property>uvd/Cm</property></product></function></axis>
    <axis name="YAW"><function name="aero/moment/uvd-yaw"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/bw-ft</property><property>uvd/Cn</property></product></function></axis>
  </aerodynamics>
</fdm_config>
