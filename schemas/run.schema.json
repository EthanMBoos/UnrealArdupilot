{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unrealvehicledynamics.local/schemas/run-v1.json",
  "title": "UnrealVehicleDynamics run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frontend", "run_id", "aircraft", "clock", "world", "atmosphere", "initial_state", "controls", "stop"],
  "properties": {
    "schema_version": {"const": 1},
    "frontend": {"enum": ["headless", "unreal"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "aircraft": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}},
    "clock": {"type": "object", "additionalProperties": false, "required": ["fixed_dt_s", "motion_solver"], "properties": {"fixed_dt_s": {"type": "number", "exclusiveMinimum": 0}, "motion_solver": {"enum": ["rk4", "chaos"]}}},
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_latitude_deg", "origin_longitude_deg", "origin_altitude_msl_m", "starting_heading_deg"],
      "properties": {
        "origin_latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "origin_longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "origin_altitude_msl_m": {"type": "number"},
        "starting_heading_deg": {"type": "number"},
        "geoid_undulation_m": {"type": "number"},
        "cesium": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tileset_asset_id"],
          "properties": {
            "tileset_asset_id": {"type": "integer", "minimum": 1},
            "imagery_asset_id": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "atmosphere": {"type": "object", "additionalProperties": false, "required": ["kind", "wind_ned_mps"], "properties": {"kind": {"const": "isa"}, "wind_ned_mps": {"$ref": "#/$defs/vec3"}}},
    "initial_state": {"$ref": "#/$defs/state"},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_boundary", "mode", "schedule", "final"],
      "properties": {
        "input_boundary": {"enum": ["aircraft_command", "aircraft_effector"]},
        "mode": {"enum": ["absolute", "offset_from_trim"]},
        "trim_path": {"type": "string"},
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["apply_tick", "values"],
            "properties": {
              "apply_tick": {"type": "integer", "minimum": 0},
              "arrival_tick": {"type": "integer", "minimum": 0},
              "time_s": {"type": "number", "minimum": 0},
              "values": {"type": "object", "additionalProperties": false, "properties": {"aileron": {"type": "number"}, "elevator": {"type": "number"}, "rudder": {"type": "number"}, "throttle": {"type": "number"}}}
            }
          }
        },
        "final": {"enum": ["hold", "stop"]}
      }
    },
    "stop": {"type": "object", "additionalProperties": false, "properties": {"duration_s": {"type": "number", "exclusiveMinimum": 0}, "final_tick": {"type": "integer", "minimum": 1}}, "oneOf": [{"required": ["duration_s"]}, {"required": ["final_tick"]}]},
    "controller": {"$ref": "#/$defs/controller"},
    "unreal_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "render_rate_hz"],
      "properties": {
        "kind": {"enum": ["aircraft", "unit_force", "unit_torque"]},
        "render_rate_hz": {"type": "number", "minimum": 1, "maximum": 1000},
        "render_hitch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["at_tick", "duration_s"],
          "properties": {
            "at_tick": {"type": "integer", "minimum": 0},
            "duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 5}
          }
        }
      }
    },
    "tolerances": {"type": "object", "additionalProperties": true},
    "output_root": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"frontend": {"const": "headless"}}},
      "then": {
        "properties": {"clock": {"properties": {"motion_solver": {"const": "rk4"}}}},
        "allOf": [
          {"not": {"required": ["controller"]}},
          {"not": {"required": ["unreal_probe"]}}
        ]
      }
    },
    {
      "if": {"properties": {"frontend": {"const": "unreal"}}},
      "then": {
        "properties": {
          "clock": {"properties": {"motion_solver": {"const": "chaos"}}}
        }
      }
    }
  ],
  "$defs": {
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "quat": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "state": {"type": "object", "additionalProperties": false, "required": ["position_ned_m", "q_body_to_ned", "velocity_body_mps", "omega_body_radps"], "properties": {"position_ned_m": {"$ref": "#/$defs/vec3"}, "q_body_to_ned": {"$ref": "#/$defs/quat"}, "velocity_body_mps": {"$ref": "#/$defs/vec3"}, "omega_body_radps": {"$ref": "#/$defs/vec3"}}},
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "firmware_commit", "mode", "udp_port", "startup_timeout_s", "packet_timeout_s", "warmup_s"],
      "properties": {
        "kind": {"const": "ardupilot_json"},
        "firmware_commit": {"const": "e0652af4c0c9657c04672ed3e21b71de75c74763"},
        "mode": {"const": "FBWA"},
        "udp_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "startup_timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "packet_timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "warmup_s": {"type": "number", "minimum": 0},
        "release": {"enum": ["timed", "readiness"]},
        "control_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "readiness_timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "stable_pwm_frames": {"type": "integer", "minimum": 1}
      }
    }
  }
}
