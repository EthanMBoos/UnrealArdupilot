{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unrealvehicledynamics.local/schemas/run-v1.json",
  "title": "UnrealVehicleDynamics headless run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "aircraft", "clock", "world", "atmosphere", "initial_state", "controls", "stop"],
  "properties": {
    "schema_version":{"const":1},
    "run_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]+$"},
    "aircraft":{"type":"object","additionalProperties":false,"required":["path"],"properties":{"path":{"type":"string","minLength":1}}},
    "clock":{"type":"object","additionalProperties":false,"required":["fixed_dt_s","integrator"],"properties":{"fixed_dt_s":{"type":"number","exclusiveMinimum":0},"integrator":{"const":"rk4"}}},
    "world":{"type":"object","additionalProperties":false,"required":["origin_latitude_deg","origin_longitude_deg","origin_altitude_msl_m","starting_heading_deg"],"properties":{"origin_latitude_deg":{"type":"number","minimum":-90,"maximum":90},"origin_longitude_deg":{"type":"number","minimum":-180,"maximum":180},"origin_altitude_msl_m":{"type":"number"},"starting_heading_deg":{"type":"number"}}},
    "atmosphere":{"type":"object","additionalProperties":false,"required":["kind","wind_ned_mps"],"properties":{"kind":{"const":"isa"},"wind_ned_mps":{"$ref":"#/$defs/vec3"}}},
    "initial_state":{"$ref":"#/$defs/state"},
    "controls":{
      "type":"object","additionalProperties":false,"required":["input_boundary","mode","schedule","final"],
      "properties":{
        "input_boundary":{"enum":["aircraft_command","aircraft_effector"]},
        "mode":{"enum":["absolute","offset_from_trim"]},
        "trim_path":{"type":"string"},
        "schedule": {
          "type":"array", "minItems":1,
          "items": {
            "type":"object", "additionalProperties":false, "required":["apply_tick","values"],
            "properties": {
              "apply_tick":{"type":"integer","minimum":0},
              "time_s":{"type":"number","minimum":0},
              "values": {
                "type":"object", "additionalProperties":false,
                "properties":{"aileron":{"type":"number"},"elevator":{"type":"number"},"rudder":{"type":"number"},"throttle":{"type":"number"}}
              }
            }
          }
        },
        "final":{"enum":["hold","stop"]}
      }
    },
    "stop":{"type":"object","additionalProperties":false,"properties":{"duration_s":{"type":"number","exclusiveMinimum":0},"final_tick":{"type":"integer","minimum":1}},"oneOf":[{"required":["duration_s"]},{"required":["final_tick"]}]},
    "tolerances":{"type":"object","additionalProperties":true},
    "output_root":{"type":"string"}
  },
  "$defs": {
    "vec3":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
    "quat":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"}},
    "state":{"type":"object","additionalProperties":false,"required":["position_ned_m","q_body_to_ned","velocity_body_mps","omega_body_radps"],"properties":{"position_ned_m":{"$ref":"#/$defs/vec3"},"q_body_to_ned":{"$ref":"#/$defs/quat"},"velocity_body_mps":{"$ref":"#/$defs/vec3"},"omega_body_radps":{"$ref":"#/$defs/vec3"}}}
  }
}
